-- =========================================================
-- SNOWFLAKE + BITBUCKET SHARED TEAM SETUP
-- Using existing role: TEAM_DATA_ENG
-- Based on names visible in your screenshot
-- =========================================================

-- ---------------------------------------------------------
-- 0. ADMIN STEP
-- ---------------------------------------------------------
USE ROLE ACCOUNTADMIN;

-- Optional: only if TEAM_DATA_ENG needs ability to create integrations
-- In production, usually admin creates the integration and team only gets USAGE
GRANT CREATE INTEGRATION ON ACCOUNT TO ROLE TEAM_DATA_ENG;

-- ---------------------------------------------------------
-- 1. USE TEAM ROLE AND TARGET SCHEMA
-- ---------------------------------------------------------
USE ROLE TEAM_DATA_ENG;
USE SCHEMA TEAM_DATA_ENG.HITENDRA_SAHAY;

-- ---------------------------------------------------------
-- 2. CREATE SHARED SECRET
--    Do NOT paste normal user password unless your org explicitly allows it.
--    Prefer Bitbucket app password / PAT.
-- ---------------------------------------------------------
CREATE OR REPLACE SECRET TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_BITBUCKET_SECRET
  TYPE = PASSWORD
  USERNAME = '<BITBUCKET_USERNAME_OR_x-token-auth>'
  PASSWORD = '<BITBUCKET_APP_PASSWORD_OR_PAT>';

-- ---------------------------------------------------------
-- 3. CREATE API INTEGRATION
-- ---------------------------------------------------------
USE ROLE ACCOUNTADMIN;

CREATE OR REPLACE API INTEGRATION HITENDRA_PRIVATE_BITBUCKET_API_INTEGRATION
  API_PROVIDER = git_https_api
  API_ALLOWED_PREFIXES = ('https://bitbucket.org/ascap/')
  ALLOWED_AUTHENTICATION_SECRETS = (TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_BITBUCKET_SECRET)
  ENABLED = TRUE;

-- Give team role access to integration
GRANT USAGE ON INTEGRATION HITENDRA_PRIVATE_BITBUCKET_API_INTEGRATION
TO ROLE TEAM_DATA_ENG;

-- ---------------------------------------------------------
-- 4. GRANT ACCESS TO SECRET
-- ---------------------------------------------------------
GRANT USAGE ON SECRET TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_BITBUCKET_SECRET
TO ROLE TEAM_DATA_ENG;

-- ---------------------------------------------------------
-- 5. CREATE GIT REPOSITORY OBJECT
-- ---------------------------------------------------------
USE ROLE TEAM_DATA_ENG;
USE SCHEMA TEAM_DATA_ENG.HITENDRA_SAHAY;

CREATE OR REPLACE GIT REPOSITORY TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO
  API_INTEGRATION = HITENDRA_PRIVATE_BITBUCKET_API_INTEGRATION
  GIT_CREDENTIALS = TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_BITBUCKET_SECRET
  ORIGIN = 'https://bitbucket.org/ascap/hitendra_private_repo.git';

-- Grant usage on repo to the team role
GRANT USAGE ON GIT REPOSITORY TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO
TO ROLE TEAM_DATA_ENG;

-- ---------------------------------------------------------
-- 6. FETCH LATEST CONTENT
-- ---------------------------------------------------------
ALTER GIT REPOSITORY TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO FETCH;

-- ---------------------------------------------------------
-- 7. TEST COMMANDS
-- ---------------------------------------------------------

-- List files from main branch
LS @TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO/branches/main;

-- List files from a specific branch
-- LS @TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO/branches/<branch_name>;

-- Show branches
SHOW GIT BRANCHES IN GIT REPOSITORY TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO;

-- Show tags
SHOW GIT TAGS IN GIT REPOSITORY TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO;

-- Execute SQL directly from repo
-- EXECUTE IMMEDIATE FROM
-- @TEAM_DATA_ENG.HITENDRA_SAHAY.HITENDRA_PRIVATE_BITBUCKET_REPO/branches/<branch_name>/<folder>/<sql_filename>.sql;





